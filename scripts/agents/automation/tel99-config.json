{
  "schema_version": 1,
  "state_dir": "~/Desktop/TEL99_ANTIGRAVITY_AUTOFEED_20261124_STATE",
  "auto_feed": true,
  "minutes": 60,
  "poll_interval": 30,
  "cockpit_port": 8765,
  "isolate_blocked": true,
  "allow_subscription_cli": false,
  "hybrid_free_cloud": {
    "enabled": true,
    "require_non_confidential": true,
    "allow_paid_fallback": false,
    "priority_order": ["groq", "openrouter", "ollama"],
    "groq_endpoint": "https://api.groq.com/openai/v1",
    "groq_allowlist": ["openai/gpt-oss-120b", "qwen/qwen3.8-27b", "openai/gpt-oss-20b"],
    "openrouter_endpoint": "https://openrouter.ai/api/v1",
    "openrouter_free_suffix_required": ":free",
    "local_key_file": "~/.tel99/providers.env"
  },
  "sdk_backend": {
    "enabled": false,
    "fallback_to_ollama_native": true,
    "compaction_token_threshold": 4500,
    "tool_output_max_tokens": 600,
    "max_concurrency": 1,
    "experimental_features_disabled": [
      "skills_paths_on_gemma4_8k",
      "multi_subagent_single_root_cpu"
    ]
  },
  "notes": "Configuration simple TEL99. Reutilise TEL99_ANTIGRAVITY_AUTOFEED_20261124_STATE sans rejeu. Aucune fusion automatique dans main, aucun ordre de trading, aucune depense API non autorisee."
}
