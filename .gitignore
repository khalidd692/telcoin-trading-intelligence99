# Caches Python (regenerees automatiquement, jamais versionnees)
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Etat local de l'orchestrateur d'autonomie (KV store en production)
.tel99-automation-state/

# Etat local du lanceur natif (journaux de mission, artefacts)
.tel99-native-state/
/memory/evaluations/

# NOTE : les artefacts de resultat (backtest_results*.json, oos_results.json) et
# les fichiers de travail des autres agents (_probe_*.py, _reconstructions/) ne
# sont PAS ignores : ils restent visibles et doivent etre arbitres explicitement
# avant toute operation Git.
